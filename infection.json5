{
  "$schema": "https://raw.githubusercontent.com/infection/infection/master/resources/schema.json",
  "source": {
    "directories": ["src"]
  },
  "logs": {
    "summary": "build/infection-summary.log"
  },
  "mutators": {
    "@default": true,
    // SvgArcConverter::calculateArcCenter — line 137: denominator tolerance boundary.
    // The formula radiusX2 * primeY2 + radiusY2 * primeX2 never equals the exact
    // float literal 1e-10 via any reachable ArcParams input (IEEE-754 arithmetic),
    // so GreaterThan (> vs >=) is an equivalent mutation here.
    "GreaterThan": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcCenter",
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    // SvgArcConverter::calculateArcAngles — vectorV = -vectorU always, therefore
    // deltaAngle = acos(-1) = pi always (when magnitude > 1e-10), cross = 0 always.
    // The following mutations are equivalent or target dead code:
    //   OneZeroFloat: min(0.0,...) vs min(1.0,...) — clamped to -1 regardless
    //   Multiplication: dot-product operand — cosDA stays -1 due to clamping
    //   Minus: cross-product sign — cross is always 0, sign irrelevant
    //   LessThan (181): deltaAngle < 0 vs <= 0 — deltaAngle = pi, never negative
    //   IncrementInteger / Identical / LogicalAndAllSubExprNegation — branch never taken
    //   Assignment / PlusEqual on line 182: dead code (elseif branch never entered)
    "OneZeroFloat": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "Multiplication": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "Minus": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "LessThan": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "IncrementInteger": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "Identical": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "LogicalAndAllSubExprNegation": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "Assignment": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    "PlusEqual": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::calculateArcAngles"
      ]
    },
    // SvgArcConverter::generateArcCurves — line 229: (int) ceil(...).
    // PHP for-loop comparison works identically with int or float, so CastInt is equivalent.
    "CastInt": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgArcConverter::generateArcCurves"
      ]
    },
    // SvgColorResolver::extractValueFromStyleAttribute — line 177: trim($declaration).
    // Removing trim() is equivalent: a whitespace-only declaration still fails the
    // count(explode(':', ..., 2)) !== 2 check, so the continue is still reached.
    // SvgColorResolver::extractValueFromStyleAttribute — line 183: continue -> break.
    // Infection reports NoCoverage here but the test
    // "skip blank declarations before valid property" does execute this path.
    // The Continue_ mutation is functionally non-equivalent (break would lose results),
    // but Infection cannot resolve coverage for this line in this configuration.
    // SvgColorResolver::extractClasses — lines 241-246:
    //   UnwrapTrim (241): leading/trailing spaces produce empty tokens, but
    //     array_filter(fn => $class !== '') removes them anyway.
    //   LogicalOr (242): || -> && — preg_replace never returns null on a string,
    //     making !is_string() always false; && prevents any real difference.
    //   UnwrapArrayValues (246): array_filter preserves numeric keys, but foreach ignores key order.
    //   UnwrapArrayFilter (246): after trim()+preg_replace, no empty tokens exist; filter is a no-op.
    "UnwrapTrim": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractValueFromStyleAttribute",
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractClasses"
      ]
    },
    "Continue_": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractValueFromStyleAttribute"
      ]
    },
    "LogicalOr": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractClasses"
      ]
    },
    "UnwrapArrayValues": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractClasses"
      ]
    },
    "UnwrapArrayFilter": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::extractClasses"
      ]
    },
    // SvgColorResolver::parseRgbColor — line 282: PregMatchRemoveDollar removes end anchor $.
    // '123abc' passes /^\d+/ but filter_var($part, FILTER_VALIDATE_INT) still rejects it,
    // so the behavior is identical.
    "PregMatchRemoveDollar": {
      "ignore": [
        "LibreSign\\XObjectTemplate\\Pdf\\Svg\\SvgColorResolver::parseRgbColor"
      ]
    }
  },
  "phpUnit": {
    "customPath": "vendor-bin/phpunit/vendor/bin/phpunit"
  },
  "minMsi": 100,
  "minCoveredMsi": 100,
  "testFramework": "phpunit",
  "timeout": 120
}
